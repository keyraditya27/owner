# =====================================================================
# ARL Keuangan Internal — variabel lingkungan
# Ganti nama file ini jadi .env.local lalu isi nilainya.
# JANGAN pernah unggah file .env.local ke GitHub.
# =====================================================================

# --- Supabase (Project Settings → API) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Kunci ini melewati semua aturan keamanan baris.
# HANYA dipakai di server. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Gemini (aistudio.google.com/apikey) -----------------------------
# Tanpa awalan NEXT_PUBLIC_ supaya tidak ikut terkirim ke browser.
GEMINI_API_KEY=AIza...

# --- Google Sheets (service account) ---------------------------------
# Dari file JSON service account. Sheet harus dibagikan ke client_email
# sebagai Editor. Lihat integrasi-google-sheets.md.
GOOGLE_SHEET_ID=1YTJYOXRZGH4SN8Hw_3w7IKIoonDoWWjpZ-7cxIj5Uck
GOOGLE_SERVICE_ACCOUNT_EMAIL=arl-sheets-sync@arl-keuangan.iam.gserviceaccount.com

# Salin nilai private_key dari file JSON PERSIS apa adanya, termasuk
# \n di dalamnya, lalu bungkus dengan tanda kutip ganda.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Rahasia untuk melindungi endpoint cron dari pemanggilan sembarangan.
CRON_SECRET=buat-teks-acak-panjang-di-sini

# --- Aplikasi --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
