# =====================================================================
# ARL Keuangan Internal — variabel lingkungan
# Ganti nama file ini jadi .env.local lalu isi nilainya.
# JANGAN pernah unggah file .env.local ke GitHub.
# =====================================================================

# --- Supabase (Project Settings → API) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Kunci ini melewati semua aturan keamanan baris.
# HANYA dipakai di server. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- AI untuk chat ----------------------------------------------------
# Isi SALAH SATU. Kalau NVIDIA_API_KEY terisi, NVIDIA yang dipakai.
# NVIDIA (build.nvidia.com → API Key). Tanpa awalan NEXT_PUBLIC_.
NVIDIA_API_KEY=nvapi-...
# Opsional: paksa model lain (dipisah koma) / model pembaca foto.
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_MODEL_GAMBAR=meta/llama-3.2-11b-vision-instruct

# Gemini (aistudio.google.com/apikey) — cadangan kalau tidak pakai NVIDIA.
# Tanpa awalan NEXT_PUBLIC_ supaya tidak ikut terkirim ke browser.
GEMINI_API_KEY=AIza...
# Opsional: paksa model tertentu. Kosongkan supaya otomatis memilih Flash terbaru.
# GEMINI_MODEL=gemini-3.8-flash

# --- Google Sheets (service account) ---------------------------------
# Sheet harus dibagikan ke client_email service account sebagai Editor.
# Lihat integrasi-google-sheets.md.
GOOGLE_SHEET_ID=1YTJYOXRZGH4SN8Hw_3w7IKIoonDoWWjpZ-7cxIj5Uck

# CARA PALING MUDAH: tempel SELURUH isi file JSON service account di sini
# (di Vercel boleh banyak baris). Kalau ini diisi, dua variabel di bawah tidak perlu.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Atau isi terpisah:
GOOGLE_SERVICE_ACCOUNT_EMAIL=arl-sheets-sync@arl-keuangan.iam.gserviceaccount.com

# Salin nilai private_key dari file JSON PERSIS apa adanya, termasuk
# \n di dalamnya, lalu bungkus dengan tanda kutip ganda.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Rahasia untuk melindungi endpoint cron dari pemanggilan sembarangan.
CRON_SECRET=buat-teks-acak-panjang-di-sini

# --- Aplikasi --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
